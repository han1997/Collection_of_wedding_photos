/* 活动头部 */
.hero {
  background: #ffffff;
  padding: 44rpx 32rpx 36rpx;
  border-bottom: 1rpx solid #f0eeec;
}

.hero-sub {
  margin-top: 10rpx;
}

.welcome {
  margin-top: 22rpx;
  font-size: 28rpx;
  color: #4a4a4a;
  line-height: 1.7;
  padding: 20rpx 24rpx;
  background: #faf8f7;
  border-radius: 14rpx;
}

.meta {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #9a9a9a;
}

/* 上传按钮区 */
.upload-cta {
  padding: 32rpx;
}

/* 分区标题 */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 12rpx 32rpx 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

/* 网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  gap: 12rpx;
}

.grid-item {
  position: relative;
  width: calc((100% - 24rpx) / 3);
  padding-bottom: calc((100% - 24rpx) / 3);
  border-radius: 12rpx;
  overflow: hidden;
  background: #ececec;
}

.grid-thumb {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.grid-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #b9b9b9;
}

/* 角标 */
.badge {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  color: #ffffff;
}

.badge-video {
  right: 8rpx;
  bottom: 8rpx;
  background: rgba(0, 0, 0, 0.55);
}

.play-tri {
  font-size: 18rpx;
}

.badge-processing {
  left: 8rpx;
  top: 8rpx;
  background: rgba(200, 85, 61, 0.85);
}
