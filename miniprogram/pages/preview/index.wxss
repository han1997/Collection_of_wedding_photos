page {
  background: #000000;
}

.viewer {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #000000;
}

.swiper,
.slide {
  width: 100%;
  height: 100%;
}

.media {
  width: 100%;
  height: 100%;
}

.processing-tip {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  color: #ffffff;
  font-size: 26rpx;
  background: rgba(0, 0, 0, 0.6);
  padding: 14rpx 26rpx;
  border-radius: 30rpx;
}

/* 顶栏 */
.topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding: calc(20rpx + env(safe-area-inset-top)) 32rpx 20rpx;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.counter {
  color: #ffffff;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.16);
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
}

/* 底栏 */
.bottombar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0));
}

.meta {
  text-align: center;
  color: rgba(255, 255, 255, 0.65);
  font-size: 24rpx;
  margin-bottom: 26rpx;
}

.dot {
  margin: 0 10rpx;
}

.actions {
  display: flex;
  justify-content: space-around;
}

.action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 30rpx;
}

.action-icon {
  font-size: 40rpx;
  color: #ffffff;
  line-height: 1;
}

.action-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-title {
  text-align: center;
  font-size: 28rpx;
  color: #9a9a9a;
  padding: 32rpx 0 12rpx;
}

.sheet-item {
  text-align: center;
  font-size: 32rpx;
  color: #1a1a1a;
  padding: 30rpx 0;
  border-top: 1rpx solid #f2f0ee;
}

.sheet-cancel {
  text-align: center;
  font-size: 32rpx;
  color: #6b6b6b;
  padding: 30rpx 0;
  border-top: 16rpx solid #f7f7f8;
}
