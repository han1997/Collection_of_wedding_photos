# ============================================================================
# 婚礼照片收集系统 —— 环境变量样例
#
# 用法：复制成 .env 后填入真实值。.env 已被 .gitignore 排除，绝不会进版本库。
#   cp .env.example .env
#
# 生成随机密钥：
#   openssl rand -base64 48
# ============================================================================

# ---------------------------------------------------------------------------
# 基础
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
TZ=Asia/Shanghai

# 数据根目录（容器内路径）。必须与 docker-compose 里的 bind mount 目标一致。
DATA_ROOT=/data

# 对外访问基址，用于生成签名 URL、二维码兜底链接、海报等。
# 必须是 https:// 并且是小程序后台里配置过的合法域名。
PUBLIC_BASE_URL=https://photos.example.com

# 媒体基址。通常与 PUBLIC_BASE_URL 相同；
# 若媒体流量要单独走一个 DNS-only 子域名（绕过 Cloudflare 的视频 egress 限制），
# 才需要单独设置。留空则回退到 PUBLIC_BASE_URL。
MEDIA_BASE_URL=

# 反向代理后面才设 true（容器只绑 127.0.0.1，由反代对外）。
# ⚠️ 若容器直接暴露到公网，设 true 会让直连者能伪造 X-Forwarded-For。
TRUST_PROXY=true

# ---------------------------------------------------------------------------
# 密钥（务必自己生成，不要用样例值）
# ---------------------------------------------------------------------------
# 宾客会话 JWT 签名密钥，32 字节以上随机
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

# 媒体签名 URL 的 HMAC 密钥，必须与 JWT_SECRET 不同，32 字节以上随机
FILE_TOKEN_SECRET=CHANGE_ME_openssl_rand_base64_48

# ---------------------------------------------------------------------------
# 管理员（仅首次启动且 admins 表为空时用于 seed，首登强制改密）
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_before_first_boot

# ---------------------------------------------------------------------------
# 微信小程序
# ---------------------------------------------------------------------------
# ⚠️ AppSecret 只存在于这里（服务端）。绝不写进 miniprogram/ 的任何文件。
WX_APPID=
WX_SECRET=

# 生成小程序码时用哪个版本：release（正式版）| trial（体验版）| develop（开发版）
# 小程序还没发布时必须用 trial 或 develop，否则扫出来是白屏。
WX_ENV_VERSION=trial

# 小程序码里指向的页面路径
WX_QR_PAGE=pages/event/index

# ---------------------------------------------------------------------------
# 上传限制
# ---------------------------------------------------------------------------
# 单文件上限（MB）。相册选择不受 60 秒限制，宾客可能传很大的视频。
MAX_UPLOAD_MB=4096

# 单个宾客在单场活动里的累计上限（GB）
MAX_GUEST_GB=20

# 单场活动累计上限（GB）
MAX_EVENT_GB=200

# 单场活动每小时的允许上传次数
MAX_EVENT_UPLOADS_PER_HOUR=500

# 分片大小（MB），客户端会在 [1,16] 内自适应，服务端负责夹取
CHUNK_SIZE_MB=4

# ---------------------------------------------------------------------------
# 媒体处理
# ---------------------------------------------------------------------------
# 图片处理并发。弱 NAS 上保持 1，别调高。
THUMB_CONCURRENCY=1

# 视频转码，默认关闭。弱 NAS 上转码会钉死 CPU 并拖慢宾客上传。
TRANSCODE_ENABLED=false

# .mov -> .mp4 重封装，默认关闭（CPU 便宜但要整读整写，磁盘 I/O 会拖慢上传）
REMUX_ENABLED=false

# 内容安全检测（img_sec_check / msgSecCheck）。合规需要，但接口抖动时会自动放行。
CONTENT_CHECK_ENABLED=true
