.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 22rpx;
}

.row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.row-key {
  width: 200rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: #6b6b6b;
}

.row-val {
  flex: 1;
  font-size: 27rpx;
  color: #1a1a1a;
  line-height: 1.65;
}

.bullet {
  font-size: 27rpx;
  color: #1a1a1a;
  line-height: 2;
}

.body-text {
  font-size: 27rpx;
  color: #1a1a1a;
  line-height: 1.75;
}
