/* 全局样式：一套克制的浅色主题，重点是把照片衬出来 */

page {
  background: #f7f7f8;
  color: #1a1a1a;
  font-size: 30rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  line-height: 1.6;
}

/* 通用容器 */
.page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 主按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #c8553d;
  color: #ffffff;
}

.btn-primary.btn-disabled {
  background: #d9d9d9;
  color: #8a8a8a;
}

.btn-ghost {
  background: #ffffff;
  color: #c8553d;
  border: 2rpx solid #e8d5cf;
}

/* 文字层级 */
.title {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
}

.subtitle {
  font-size: 28rpx;
  color: #6b6b6b;
}

.muted {
  font-size: 26rpx;
  color: #9a9a9a;
}

.center {
  text-align: center;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  text-align: center;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #f0eeec;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 28rpx;
}

/* 提示条 */
.banner {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 22rpx 26rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.banner-warn {
  background: #fdf3e7;
  color: #8a5a1f;
}

.banner-info {
  background: #eef4fb;
  color: #31567f;
}

/* 加载中 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
  color: #9a9a9a;
  font-size: 28rpx;
}

/* 表单字段：管理端和登录页共用 */
.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #6b6b6b;
  margin-bottom: 12rpx;
}

.input {
  height: 92rpx;
  background: #f7f7f8;
  border-radius: 14rpx;
  padding: 0 26rpx;
  font-size: 30rpx;
}

.textarea {
  min-height: 140rpx;
  background: #f7f7f8;
  border-radius: 14rpx;
  padding: 22rpx 26rpx;
  font-size: 30rpx;
  line-height: 1.6;
}

.picker-field {
  height: 92rpx;
  background: #f7f7f8;
  border-radius: 14rpx;
  padding: 0 26rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  color: #1a1a1a;
}

.picker-field.placeholder {
  color: #b0b0b0;
}

/* 列表项 */
.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f2f0ee;
}

.list-row:last-child {
  border-bottom: none;
}
