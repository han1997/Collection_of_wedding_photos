# 复制为 .env 并填入自己的配置；真实 .env 不进版本库。
NODE_ENV=development
PORT=3000
TZ=Asia/Shanghai
PUBLIC_BASE_URL=http://127.0.0.1:3000
# 生产部署改成 https://你的域名，同源提供页面、API 和文件。
# 本地开发不设置 DATA_ROOT，默认使用项目下 _data/。

# 分别运行 openssl rand -base64 48 生成两个不同的随机密钥。
JWT_SECRET=CHANGE_ME_generate_random_secret
FILE_TOKEN_SECRET=CHANGE_ME_generate_another_random_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_before_first_boot

# Docker 部署：每一场使用不同的项目名、域名、端口和目录。
HTTP_PORT=1240
BIND_ADDRESS=0.0.0.0
NAS_DATA_DIR=/vol1/1000/photos/wedding-collect
# 全网卡/局域网可直连时必须保持 false。
TRUST_PROXY=false

# 仅旧数据库包含多场婚礼时，指定要使用的活动 ID。
EVENT_ID=
MAX_UPLOAD_MB=4096
MAX_GUEST_GB=20
MAX_EVENT_GB=200
MAX_EVENT_UPLOADS_PER_HOUR=500
CHUNK_SIZE_MB=4
THUMB_CONCURRENCY=1
TRANSCODE_ENABLED=false
REMUX_ENABLED=false
